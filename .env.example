# Copy to .env and fill in. .env is gitignored.

# Supabase pooler, transaction mode (port 6543). Local `supabase start` uses
# postgresql://postgres:postgres@127.0.0.1:54322/postgres instead.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Supabase project ref (not secret), used by `supabase link --project-ref`.
SUPABASE_PROJECT_REF=<project-ref>

# GitHub Pages origin allowed by CORS, e.g. https://<user>.github.io
ALLOWED_ORIGIN=http://localhost:8000

PORT=8080
EXPERIMENTS_PATH=experiments.yaml
