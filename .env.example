# Copy to .env and fill in. .env is gitignored.

# Supabase pooler, transaction mode (port 6543): Dashboard → Connect →
# Transaction pooler. This is what the nudge service uses. Local
# `supabase start` uses postgresql://postgres:postgres@127.0.0.1:54322/postgres instead.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct connection (port 5432, IPv6 only) for running SQL by hand, e.g. the
# wipe script. The service never uses it.
DIRECT_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase project ref (not secret), used by `supabase link --project-ref`.
SUPABASE_PROJECT_REF=<project-ref>

# GitHub Pages origin allowed by CORS, e.g. https://<user>.github.io
ALLOWED_ORIGIN=http://localhost:8000

PORT=8080
EXPERIMENTS_PATH=experiments.yaml
